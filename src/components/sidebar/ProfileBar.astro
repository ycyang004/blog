    <div class="flex items-start justify-between gap-4 border-b border-base-200 pb-4">
      <div>
        <h2 class="flex items-center gap-2 text-lg font-bold text-base-content">
          <Icon name="material-symbols:auto-awesome-outline" class="h-5 w-5 text-primary" />
