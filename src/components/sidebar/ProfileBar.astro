    <div class="profile-settings-actions mt-6 flex flex-wrap justify-end gap-2 border-t border-base-200 pt-4">
      <button id="profile-settings-reset" type="button" class="btn btn-ghost btn-sm">恢复默认</button>
      <button id="profile-settings-cancel" type="button" class="btn btn-ghost btn-sm">取消</button>
      <button id="profile-settings-save" type="button" class="btn btn-primary btn-sm">
