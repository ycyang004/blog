    </div>

    <div class="mt-5">
      <div class="mb-2 text-sm font-semibold text-base-content">称号光效</div>
      <div class="effect-option-grid">
        <button type="button" class="effect-option" data-effect-group="title" data-effect-value="rainbow" aria-pressed="true">
          <span class="effect-swatch effect-swatch-rainbow"></span>
          <span>彩色流光</span>
        </button>
        <button type="button" class="effect-option" data-effect-group="title" data-effect-value="gold" aria-pressed="false">
          <span class="effect-swatch effect-swatch-gold"></span>
          <span>金色流光</span>
        </button>
        <button type="button" class="effect-option" data-effect-group="title" data-effect-value="black" aria-pressed="false">
          <span class="effect-swatch effect-swatch-black"></span>
          <span>黑色流光</span>
        </button>
        <button type="button" class="effect-option" data-effect-group="title" data-effect-value="none" aria-pressed="false">
          <span class="effect-swatch effect-swatch-none"></span>
