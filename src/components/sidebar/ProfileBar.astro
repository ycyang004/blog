        <p class="mt-1 text-xs text-base-content/55">光效会循环流动，设置保存在当前浏览器。</p>
      </div>
      <button
        id="profile-settings-close"
        type="button"
        class="btn btn-circle btn-ghost btn-sm"
        aria-label="关闭设置"
      >
        <Icon name="material-symbols:close-rounded" class="h-5 w-5" />
      </button>
    </div>

    <div class="profile-settings-preview mt-5">
      <div
        id="profile-preview-avatar"
        class="profile-preview-avatar"
        data-effect="rainbow"
        aria-hidden="true"
      >
        <span style={`background-image: url(${USER_AVATAR});`}></span>
      </div>
      <div class="min-w-0">
        <div class="text-sm font-bold text-base-content">{USER_NAME}</div>
        <div
          id="profile-preview-title-frame"
          class="profile-title-frame mt-1.5"
          data-effect="rainbow"
        >
          <span id="profile-preview-title-text">逐光者</span>
        </div>
      </div>
      <span class="profile-settings-preview-label">实时预览</span>
    </div>

    <div class="mt-5">
      <label for="profile-title-input" class="mb-2 block text-sm font-semibold text-base-content">
        称号文字
      </label>
      <input
        id="profile-title-input"
        type="text"
        class="input input-bordered w-full bg-base-100"
        maxlength="20"
        placeholder="例如：逐光者"
        autocomplete="off"
      />
      <p class="mt-1 text-xs text-base-content/45">留空可隐藏称号，最多 20 个字符。</p>
    </div>

    <div class="mt-5">
      <div class="mb-2 text-sm font-semibold text-base-content">头像光效</div>
      <div class="effect-option-grid">
        <button type="button" class="effect-option" data-effect-group="avatar" data-effect-value="rainbow" aria-pressed="true">
          <span class="effect-swatch effect-swatch-rainbow"></span>
          <span>彩色流光</span>
        </button>
        <button type="button" class="effect-option" data-effect-group="avatar" data-effect-value="gold" aria-pressed="false">
          <span class="effect-swatch effect-swatch-gold"></span>
          <span>金色流光</span>
        </button>
        <button type="button" class="effect-option" data-effect-group="avatar" data-effect-value="black" aria-pressed="false">
          <span class="effect-swatch effect-swatch-black"></span>
          <span>黑色流光</span>
        </button>
        <button type="button" class="effect-option" data-effect-group="avatar" data-effect-value="none" aria-pressed="false">
          <span class="effect-swatch effect-swatch-none"></span>
          <span>无光效</span>
        </button>
