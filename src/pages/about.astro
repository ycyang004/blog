---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import Card from "@/components/temple/Card.astro";
import GitHubStats from "@/components/mdx/GitHubStats.astro";
import { AboutEditor } from "@/components/write/AboutEditor";
import { ABOUT_CONFIG } from "../config";
---

<BaseLayout title="About" isIndexed={false}>
    <AboutEditor client:load initialData={ABOUT_CONFIG} />

    <Card class="p-4 md:p-8 mt-8">
        <section>
            <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
                <Icon name="lucide:github" class="w-6 h-6 text-primary" />
                <span>开源贡献</span>
            </h2>
            <GitHubStats username={ABOUT_CONFIG.github || "kobaridev"} showLanguages={false} showCommitGraph={true} />
        </section>
    </Card>
</BaseLayout>
